{
  "name": "@donotdev/supabase",
  "version": "0.2.3",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Supabase provider for DoNotDev — CRUD, auth, storage, server auth adapters",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    }
  },
  "scripts": {
    "dev": "tsc --noEmit --watch --listFiles false --listEmittedFiles false",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "type-check": "bunx tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "@donotdev/core": "^0.2.3"
  },
  "peerDependenciesMeta": {},
  "devDependencies": {
    "@donotdev/core": "workspace:*",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/donotdev/dndev.git"
  },
  "keywords": [
    "donotdev",
    "dndev",
    "supabase",
    "auth",
    "storage",
    "react",
    "typescript"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
